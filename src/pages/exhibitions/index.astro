---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatRange } from '../../lib/content';

const exhibitions = (await getCollection('exhibitions')).sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
---

<Layout title="Exhibitions">
  <section class="section">
    <div class="section-head"><h1>Exhibitions</h1></div>
    <div class="grid">
      {exhibitions.map((e) => (
        <a class="card" href={`/exhibitions/${e.id}`}>
          <div class="thumb">{e.data.heroImage ? <img src={e.data.heroImage} alt="" loading="lazy" /> : 'DELPHI_space'}</div>
          <span class="meta">{formatRange(e.data.startDate, e.data.endDate)}</span>
          <h3>{e.data.title}</h3>
          {e.data.artists && <p>{e.data.artists}</p>}
        </a>
      ))}
    </div>
  </section>
</Layout>
