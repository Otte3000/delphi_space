---
import Layout from '../../../layouts/Layout.astro';
import { getExhibitions } from '../../../lib/content';
import { langParams, toLang, href, pick, t, formatRange } from '../../../lib/i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const lang = toLang(Astro.params.lang);
const exhibitions = await getExhibitions();
---

<Layout lang={lang} title={t(lang, 'exhibitions')}>
  <section class="section">
    <div class="section-head"><h1>{t(lang, 'exhibitions')}</h1></div>
    <div class="grid">
      {exhibitions.map((e) => (
        <a class="card" href={href(lang, `/exhibitions/${e.slug}`)}>
          <div class="thumb">{e.heroImage || e.poster ? <img src={e.heroImage || e.poster} alt="" loading="lazy" /> : 'DELPHI_space'}</div>
          <span class="meta">{formatRange(e.startDate, e.endDate, lang)}</span>
          <h3>{pick(e.title, lang)}</h3>
          {e.artistsText && <p class="artists-line">{e.artistsText}</p>}
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .artists-line { margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
