---
// Textseiten aus dem CMS: /about, /membership, /impressum, /datenschutz (und /en/…, /fr/…)
import Layout from '../../layouts/Layout.astro';
import PartnerDiagram from '../../components/PartnerDiagram.astro';
import {
  getTextPage, renderContent, textPages, type TextPage,
  getTeam, getPartners, getFunders, getMemberships,
} from '../../lib/content';
import { langParams, toLang, pick, t } from '../../lib/i18n';

export const getStaticPaths = () => langParams.flatMap((params) => textPages.map((page) => ({ params: { ...params, page } })));

const lang = toLang(Astro.params.lang);
const page = Astro.params.page as TextPage;
const entry = await getTextPage(page);
const title = pick(entry.title, lang);
const content = renderContent(entry, lang);

// Zusätzliche Listen je Seite
const team = page === 'about' ? (await getTeam()).filter((m) => m.active && m.category === 'team') : [];
const partners = page === 'about' ? await getPartners() : [];
const funders = page === 'about' ? (await getFunders()).filter((f) => f.showOnAbout) : [];
const memberships = page === 'membership' ? await getMemberships() : [];
const membershipTexts = memberships.map((m) => ({ ...m, html: renderContent(m, lang).html }));
---

<Layout lang={lang} title={title}>
  <article class="section">
    <div class="section-head"><h1>{title}</h1></div>
    <div class="prose">
      {content.fallback && <p class="fallback-note">{t(lang, 'notTranslated')}</p>}
      <Fragment set:html={content.html} />
    </div>

    {membershipTexts.length > 0 && (
      <div class="grid memberships">
        {membershipTexts.map((m) => (
          <article>
            <h3>{pick(m.name, lang)}</h3>
            <div class="prose small"><Fragment set:html={m.html} /></div>
            {m.link && <a href={m.link}>{t(lang, 'join')}</a>}
          </article>
        ))}
      </div>
    )}

    {team.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, 'team')}</h2></div>
        <div class="grid team">
          {team.map((m) => (
            <div>
              {m.photo && <img src={m.photo} alt={m.name} loading="lazy" />}
              <h3>{m.name}</h3>
              {pick(m.role, lang) && <p class="meta">{pick(m.role, lang)}</p>}
              {pick(m.bio, lang) && <p>{pick(m.bio, lang)}</p>}
              {m.email && <p><a href={`mailto:${m.email}`}>{m.email}</a></p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {partners.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, 'partners')}</h2></div>
        <ul class="plain partners">
          {partners.map((p) => <li>{p.link ? <a href={p.link}>{p.name}</a> : p.name}</li>)}
        </ul>
        <PartnerDiagram caption={t(lang, 'partnersCaption')} />
      </section>
    )}

    {funders.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, 'funders')}</h2></div>
        <div class="logos">
          {funders.map((f) => (
            <a href={f.link || undefined} title={f.name}>{f.logo ? <img src={f.logo} alt={f.name} loading="lazy" /> : f.name}</a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .memberships { margin-top: 48px; }
  .memberships article, .team > div { display: flex; flex-direction: column; gap: 8px; padding-top: 12px; border-top: 1px solid var(--line); }
  .team p { margin: 0; }
  .small { font-size: 15px; }
  .partners { columns: 3 220px; }
</style>
