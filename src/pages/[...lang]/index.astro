---
import Layout from '../../layouts/Layout.astro';
import PlusButton from '../../components/PlusButton.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { isLandscape, isPortrait } from '../../lib/image-size';
import { getHomepage, getExhibitions, getEvents, getSeries, isCurrentOrUpcoming, locationNames } from '../../lib/content';
import { langParams, toLang, href, pick, t, eventType, exhibitionKind, formatRange, dateParts } from '../../lib/i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const lang = toLang(Astro.params.lang);
const home = await getHomepage();
const now = Date.now();

// Auftakt: laufende Ausstellung, sonst die nächste, sonst die letzte
const exhibitions = await getExhibitions();
const running = exhibitions.filter((e) => e.startDate.getTime() <= now && isCurrentOrUpcoming(e.startDate, e.endDate));
const upcoming = exhibitions.filter((e) => e.startDate.getTime() > now).reverse();
const featured = running[0] ?? upcoming[0] ?? exhibitions[0];
const featuredLabel = running[0] ? 'currentExhibition' : upcoming[0] ? 'upcomingExhibition' : 'lastExhibition';
const alsoOn = [...running, ...upcoming].filter((e) => e !== featured).slice(0, 3);
const archive = exhibitions.filter((e) => e !== featured && !alsoOn.includes(e) && !isCurrentOrUpcoming(e.startDate, e.endDate)).slice(0, 12);

// Agenda: kommende Termine, sonst die letzten
const events = await getEvents();
const upcomingEvents = events.filter((e) => isCurrentOrUpcoming(e.date, e.endDate)).reverse().slice(0, 6);
const agenda = upcomingEvents.length ? upcomingEvents : events.slice(0, 4);

const series = (await getSeries()).filter((s) => s.showOnHomepage);
// Teaser: Plakat im Hochformat links, Ausstellungsfoto im Querformat rechts – fehlt eins, springt ein passendes Galeriebild ein
const featuredImages = featured ? [featured.heroImage, ...featured.gallery.map((g) => g.image)].filter((src): src is string => Boolean(src)) : [];
const teaserPoster = featured && ((featured.poster && isPortrait(featured.poster) ? featured.poster : undefined) ?? featuredImages.find(isPortrait) ?? featured.poster);
const teaserPhoto = featuredImages.filter((src) => src !== teaserPoster).find(isLandscape) ?? featuredImages.find((src) => src !== teaserPoster);

// Hero-Bilder: die im CMS gewählten, sonst zufällig aus allen Ausstellungsbildern (Poster ausgenommen, die tragen eigenen Text)
const chosen = home.heroImages.filter((src): src is string => Boolean(src));
const allPhotos = [...new Set(exhibitions.flatMap((e) => [e.heroImage, ...e.gallery.map((g) => g.image)]).filter((src): src is string => Boolean(src)))];
const shuffle = <T,>(list: T[]) => list.map((v) => [Math.random(), v] as const).sort((a, b) => a[0] - b[0]).map(([, v]) => v);
const heroImages = chosen.length ? shuffle(chosen) : shuffle(allPhotos).slice(0, 60);
---

<Layout lang={lang}>
  <section class="hero" data-images={JSON.stringify(heroImages)}>
    {heroImages[0] && (
      <div class="hero-media">
        <img class="hero-bg" src={heroImages[0]} alt="" fetchpriority="high" />
      </div>
    )}
    <div class="hero-stack">
      {featured && (
        <a class="ticker" href={href(lang, `/exhibitions/${featured.slug}`)} aria-label={`${t(lang, featuredLabel)}: ${pick(featured.title, lang)}`}>
          <span class="ticker-window">
            <span class="ticker-track" aria-hidden="true">
              {[0, 1].map(() => (
                <span class="ticker-group">
                  {[0, 1, 2].map(() => (
                    <span class="ticker-item">
                      {t(lang, featuredLabel)} <b>—</b> {pick(featured.title, lang)} <b>—</b> {formatRange(featured.startDate, featured.endDate, lang)} <b>—</b>
                    </span>
                  ))}
                </span>
              ))}
            </span>
          </span>
        </a>
      )}
      <div class="hero-copy">
        <div class="hero-panel" aria-hidden="true"></div>
        <div class="hero-text">
          <p>{pick(home.intro, lang)}</p>
          <PlusButton href={href(lang, '/about')} label={t(lang, 'about')} />
        </div>
      </div>
    </div>
  </section>

  {featured && (
    <section class="feature">
      <a class="feature-poster" href={href(lang, `/exhibitions/${featured.slug}`)}>
        {teaserPoster ? <img src={teaserPoster} alt={`${pick(featured.title, lang)} – Plakat`} /> : <span>DELPHI_space</span>}
      </a>
      <a class="feature-photo" href={href(lang, `/exhibitions/${featured.slug}`)}>
        {teaserPhoto ? <img src={teaserPhoto} alt={pick(featured.title, lang)} /> : <span>DELPHI_space</span>}
      </a>

      <div class="feature-title">
        <p class="eyebrow">{t(lang, featuredLabel)}</p>
        <h1><a href={href(lang, `/exhibitions/${featured.slug}`)}>{pick(featured.title, lang)}</a></h1>
      </div>
      <div class="feature-text">
        <p class="feature-dates">{formatRange(featured.startDate, featured.endDate, lang)}</p>
        {pick(featured.openingHours, lang) && <p class="small">{pick(featured.openingHours, lang)}</p>}
        {locationNames[featured.location] && <p class="small">{locationNames[featured.location]}</p>}
        <PlusButton href={href(lang, `/exhibitions/${featured.slug}`)} label={`${t(lang, 'more')}: ${pick(featured.title, lang)}`} size="small" />

        {alsoOn.length > 0 && (
          <div class="also">
            <p class="eyebrow">{t(lang, 'alsoOn')}</p>
            {alsoOn.map((e) => (
              <a href={href(lang, `/exhibitions/${e.slug}`)}>
                <strong>{pick(e.title, lang)}</strong>
                <span>{formatRange(e.startDate, e.endDate, lang)}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="row">
    <h2 class="row-label"><span>{t(lang, 'dates')}</span></h2>
    <div class="row-body">
      <ol class="agenda">
        {agenda.map((e) => {
          const d = dateParts(e.date, lang);
          return (
            <li>
              <a href={href(lang, `/events/${e.slug}`)}>
                <span class="agenda-day">{d.day}</span>
                <span class="agenda-when">{d.month}<br />{d.weekday}{e.time && <><br />{e.time}</>}</span>
                <span class="agenda-what">
                  <span class="agenda-type">{eventType(e.type, lang)}</span>
                  <span class="agenda-title">{pick(e.title, lang)}</span>
                  {pick(e.subtitle, lang) && <span class="agenda-sub">{pick(e.subtitle, lang)}</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
      <PlusButton href={href(lang, '/events')} label={t(lang, 'allEvents')} size="small" />
    </div>
  </section>


  {series.length > 0 && (
    <section class="row">
      <h2 class="row-label"><span>{t(lang, 'programme')}</span></h2>
      <div class="row-body">
        <div class="series">
          {series.slice(0, 3).map((s) => <SeriesCard lang={lang} series={s} />)}
        </div>
        <PlusButton href={href(lang, '/series')} label={t(lang, 'allSeries')} size="small" />
      </div>
    </section>
  )}

  {archive.length > 0 && (
    <section class="archive">
      <div class="archive-head">
        <h2><span>{t(lang, 'archive')}</span></h2>
        <a class="more" href={href(lang, '/exhibitions')}>{t(lang, 'allExhibitions')} →</a>
      </div>
      <div class="archive-strip">
        {archive.map((e) => (
          <a class="archive-card" href={href(lang, `/exhibitions/${e.slug}`)}>
            {(e.heroImage || e.poster) ? <img src={e.heroImage || e.poster} alt="" loading="lazy" /> : <span class="archive-empty" />}
            <span class="archive-caption">
              <span class="archive-kind">{exhibitionKind(e.kind, lang)} · {e.startDate.getUTCFullYear()}</span>
              <strong>{pick(e.title, lang)}</strong>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}


  <section class="member">
    <h2>{pick(home.memberTitle, lang) || t(lang, 'membership')}</h2>
    <div>
      {pick(home.memberText, lang) && <p>{pick(home.memberText, lang)}</p>}
      <a class="more" href={href(lang, '/membership')}>{t(lang, 'join')}</a>
    </div>
  </section>
</Layout>

<script>
  // Alle 4 Sekunden ein zufälliges anderes Bild, harter Schnitt ohne Überblendung.
  const hero = document.querySelector<HTMLElement>('.hero');
  const bg = hero?.querySelector<HTMLImageElement>('.hero-bg');
  const images: string[] = hero ? JSON.parse(hero.dataset.images ?? '[]') : [];
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bg && images.length > 1 && !reduceMotion) {
    let current = 0;
    const pickNext = () => {
      let next = current;
      while (next === current) next = Math.floor(Math.random() * images.length);
      return next;
    };
    // nächstes Bild schon vorladen, damit der Wechsel ohne Lücke passiert
    let next = pickNext();
    let preload = new Image();
    preload.src = images[next];

    setInterval(() => {
      if (document.hidden || !preload.complete) return;
      bg.src = images[next];
      current = next;
      next = pickNext();
      preload = new Image();
      preload.src = images[next];
    }, 4000);
  }

  // Maus über dem Bild: Bild springt vor den Text, wird etwas größer und folgt dem Zeiger leicht magnetisch.
  const media = hero?.querySelector<HTMLElement>('.hero-media');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (hero && media && finePointer && !reduceMotion) {
    const PULL = 0.06; // wie stark das Bild dem Zeiger folgt (Anteil des Abstands zur Bildmitte)
    const SCALE = 1.04;
    const target = { x: 0, y: 0, s: 1 };
    const state = { x: 0, y: 0, s: 1 };
    let frame = 0;

    const render = () => {
      // weich hinterherziehen
      state.x += (target.x - state.x) * 0.12;
      state.y += (target.y - state.y) * 0.12;
      state.s += (target.s - state.s) * 0.12;
      media.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.s})`;
      const settled = Math.abs(target.x - state.x) < 0.1 && Math.abs(target.y - state.y) < 0.1 && Math.abs(target.s - state.s) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(render);
    };
    const kick = () => { if (!frame) frame = requestAnimationFrame(render); };

    hero.addEventListener('pointermove', (event) => {
      // Lage ohne die laufende Verschiebung messen, damit die Trefferfläche nicht mitwandert
      const rect = media.getBoundingClientRect();
      const w = rect.width / state.s;
      const h = rect.height / state.s;
      const left = rect.left + rect.width / 2 - state.x - w / 2;
      const top = rect.top + rect.height / 2 - state.y - h / 2;
      const inside = event.clientX >= left && event.clientX <= left + w && event.clientY >= top && event.clientY <= top + h;

      media.classList.toggle('is-front', inside);
      target.x = inside ? (event.clientX - (left + w / 2)) * PULL : 0;
      target.y = inside ? (event.clientY - (top + h / 2)) * PULL : 0;
      target.s = inside ? SCALE : 1;
      kick();
    });

    hero.addEventListener('pointerleave', () => {
      media.classList.remove('is-front');
      target.x = target.y = 0;
      target.s = 1;
      kick();
    });
  }
</script>

<style>
  /* ── Gemeinsames ───────────────────────────────────── */
  .eyebrow { margin: 0 0 12px; color: var(--muted); font-family: var(--mono); font-style: italic; font-weight: 400; font-size: 21px; }
  .small { margin: 0 0 4px; font-size: 15px; }
  .strong { font-weight: 700; }
  .more { display: inline-block; margin-top: 16px; font-size: 15px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  h2 span { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }

  /* ── Hero: Text über wechselnden Bildern ───────────── */
  .hero {
    position: relative;
    min-height: calc(100svh - 90px);
    display: flex;
    align-items: flex-end;
    padding-bottom: 0;
  }
  /* Bild: 65 % der Bildschirmbreite, rechtsbündig, mit Abstand zur Kopfzeile */
  .hero-media {
    position: absolute;
    top: 48px;
    right: 0;
    width: 65vw;
    height: calc(100% - 168px);
    will-change: transform;
  }
  /* Beim Darüberfahren springt das Bild vor den Text (siehe Skript unten) */
  .hero-media.is-front { z-index: 2; }
  .hero-bg { width: 100%; height: 100%; object-fit: cover; }
  /* Text und Knopf stehen auf der Achse des Logos; Milchglas und Laufband ragen dafür um den Innenabstand nach links */
  .hero-stack { position: relative; width: calc(55% + 32px); margin-left: -32px; }
  .hero-copy { position: relative; }

  /* Laufband mit der aktuellen Ausstellung, versal */
  /* Leiste im selben Milchglas wie der Textblock */
  .ticker {
    display: block;
    overflow: hidden;
    margin-bottom: 4px;
    padding: 10px 0;
    color: var(--fg);
    background: rgba(255, 255, 255, 0.3);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    text-decoration: none;
    white-space: nowrap;
  }
  .ticker:hover { color: var(--hover); }
  /* weiche Kanten links und rechts: die Schrift läuft ein- und aus, die Milchglas-Fläche bleibt voll */
  .ticker-window {
    display: block;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, transparent 8%, rgba(0, 0, 0, 0.3) 22%, #000 38%, #000 62%, rgba(0, 0, 0, 0.3) 78%, transparent 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, transparent 8%, rgba(0, 0, 0, 0.3) 22%, #000 38%, #000 62%, rgba(0, 0, 0, 0.3) 78%, transparent 92%, transparent 100%);
  }
  .ticker-track { display: inline-flex; animation: ticker 48s linear infinite; }
  .ticker-group { display: inline-flex; }
  .ticker-item { padding-right: 0.6em; font-family: var(--mono); font-style: italic; font-size: clamp(17px, 1.6vw, 23px); font-weight: 400; text-transform: uppercase; letter-spacing: 0.02em; }
  .ticker-item b { font-weight: 400; padding: 0 0.3em; }
  @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }
  /* Milchglas hinter dem Text */
  .hero-panel {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.3);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }
  .hero-text {
    position: relative;
    padding: 28px 32px 32px;
    color: var(--fg);
  }
  .hero-text p { margin: 0; font-size: clamp(18px, 1.8vw, 28px); line-height: 1.2; letter-spacing: -0.015em; font-weight: 400; }

  /* ── Ausstellungsteaser: Plakat hoch links, Foto quer rechts, gleich hoch ── */
  .feature {
    display: grid;
    /* Plakat im DIN-A-Format (1:√2) neben Foto 3:2 – gleiche Höhe bei Spalten im Verhältnis 1 : 2,12 */
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.121fr);
    gap: 24px 32px;
    padding-top: 64px;
    align-items: start;
  }
  .feature-poster,
  .feature-photo { display: block; background: var(--soft); overflow: hidden; }
  /* graue Haarlinie, damit weiße Plakatränder nicht im Weiß der Seite verschwinden */
  .feature-poster { aspect-ratio: 1 / 1.4142; outline: 1px solid var(--line); outline-offset: -1px; }
  .feature-photo { aspect-ratio: 3 / 2; }
  .feature-poster img,
  .feature-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .feature-poster:hover img,
  .feature-photo:hover img { transform: scale(1.02); }
  .feature-poster span,
  .feature-photo span { display: grid; place-items: center; height: 100%; font-weight: 700; font-size: 28px; }
  .feature h1 { font-size: clamp(30px, 3.4vw, 52px); line-height: 1; letter-spacing: -0.03em; }
  .feature h1 a { text-decoration: none; }
  .feature h1 a:hover { color: var(--hover); }
  .feature-dates { margin: 0 0 4px; font-size: 21px; font-weight: 700; }
  /* Plus-Knopf unten bündig mit der letzten Zeile des Titels links */
  .feature-text { align-self: stretch; display: flex; flex-direction: column; align-items: flex-start; }
  /* Unterlänge des Titels (≈ 0,13 × Titelgröße) ausgleichen, damit der Knopf auf der Schriftlinie steht */
  .feature-text :global(.plus-button) { margin-top: auto; margin-bottom: calc(clamp(30px, 3.4vw, 52px) * 0.13); }
  .also { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--fg); }
  .also a { display: flex; flex-direction: column; padding: 8px 0; text-decoration: none; border-bottom: 1px solid var(--line); }
  .also a:hover strong { color: var(--hover); }
  .also span { font-size: 14px; color: var(--muted); }

  /* ── Zeilen mit Bereichstitel links ────────────────── */
  .row {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 3fr);
    gap: 32px;
    margin-top: 96px;
    padding-top: 20px;
    border-top: 1px solid var(--fg);
  }
  .row-label { font-family: var(--mono); font-style: italic; font-weight: 400; font-size: clamp(30px, 3vw, 42px); align-self: start; position: sticky; top: 120px; }

  /* Agenda mit großen Tageszahlen */
  .agenda { list-style: none; margin: 0; padding: 0; }
  .agenda li { border-bottom: 1px solid var(--line); }
  .agenda li:first-child a { padding-top: 0; }
  .agenda a { display: grid; grid-template-columns: 96px 140px minmax(0, 1fr); gap: 16px; padding: 20px 0; text-decoration: none; align-items: start; }
  .agenda a:hover .agenda-title { color: var(--hover); }
  .agenda-day { font-family: var(--mono); font-style: italic; font-size: 72px; font-weight: 400; line-height: 0.85; letter-spacing: -0.02em; }
  .agenda-when { font-size: 14px; line-height: 1.35; }
  .agenda-what { display: flex; flex-direction: column; gap: 4px; }
  .agenda-type { font-family: var(--mono); font-style: italic; font-size: 17px; }
  .agenda-title { font-size: clamp(20px, 2vw, 28px); font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; }
  .agenda-sub { font-size: 14px; color: var(--muted); }


  /* Reihen */
  .series { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 32px 24px; }

  /* Archiv als Bildleiste */
  .archive { margin-top: 96px; padding-top: 20px; border-top: 1px solid var(--fg); }
  .archive-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 24px; }
  .archive-head h2 { font-size: clamp(26px, 2.6vw, 36px); }
  .archive-head .more { margin-top: 0; }
  .archive-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 22%);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 12px;
    scrollbar-width: thin;
  }
  .archive-card { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; scroll-snap-align: start; color: #fff; text-decoration: none; background: #222; }
  .archive-card img, .archive-empty { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; display: block; }
  .archive-card:hover img { transform: scale(1.04); }
  .archive-caption {
    position: absolute; inset: auto 0 0 0; display: flex; flex-direction: column; gap: 4px;
    padding: 48px 16px 16px; background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
  }
  .archive-caption strong { font-size: 20px; line-height: 1.1; }
  .archive-kind { font-size: 13px; }


  /* Mitgliedschaft: großer roter Aufruf */
  .member {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 32px;
    align-items: end;
    margin-top: 120px;
    padding: 48px 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--fg);
  }
  .member h2 { color: var(--accent); font-size: clamp(44px, 7vw, 104px); line-height: 0.95; letter-spacing: -0.04em; }
  .member p { margin: 0; font-size: 17px; max-width: 46ch; }

  /* ── Mobil ─────────────────────────────────────────── */
  @media (max-width: 900px) {
    .row, .member { grid-template-columns: 1fr; }
    /* Plakat und Foto bleiben nebeneinander, der Text rutscht über die volle Breite darunter */
    .feature { gap: 16px; }
    .feature-title, .feature-text { grid-column: 1 / -1; }
    .row-label { position: static; }
    .row { gap: 16px; margin-top: 72px; }
    .hero-stack { width: calc(80% + 32px); }
  }
  @media (max-width: 640px) {
    .hero { min-height: 88svh; padding-bottom: 24px; }
    .hero-media { top: 24px; width: 85vw; height: 58%; }
    .hero-stack { width: 100%; margin-left: 0; }
    .hero-text { padding: 20px; }
    .feature { padding-top: 40px; gap: 12px; }
    .agenda a { grid-template-columns: 64px minmax(0, 1fr); gap: 4px 12px; }
    .agenda-day { font-size: 48px; grid-row: span 2; }
    .agenda-when { font-size: 13px; }
    .archive-strip { grid-auto-columns: 72%; }
    .member { margin-top: 80px; padding: 32px 0; }
  }
</style>
