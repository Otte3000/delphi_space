---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, formatWeekday, isCurrentOrUpcoming } from '../../lib/content';

const events = (await getCollection('events')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const upcoming = events.filter((e) => isCurrentOrUpcoming(e.data.date)).reverse();
const past = events.filter((e) => !isCurrentOrUpcoming(e.data.date));
const groups = [
  { title: 'Upcoming', items: upcoming },
  { title: 'Past', items: past },
].filter((g) => g.items.length > 0);
---

<Layout title="Events">
  <section class="section">
    <div class="section-head"><h1>Events</h1></div>
  </section>
  {groups.map((g) => (
    <section class="section">
      <div class="section-head"><h2>{g.title}</h2></div>
      <ul class="list">
        {g.items.map((e) => (
          <li>
            <a href={`/events/${e.id}`}>
              <span class="meta">{formatWeekday(e.data.date)}, {formatDate(e.data.date)}</span>
              <h3>{e.data.title}</h3>
              <span class="tag">{e.data.type}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
