---
import '@fontsource/crimson-pro/latin-400-italic.css';
import '../styles/global.css';
import { getFunders, getSettings } from '../lib/content';
import { href, locales, languageNames, switchLang, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description = 'DELPHI_space – Kunst-, Kultur- und Informationszentrum in Freiburg.' } = Astro.props;
const settings = await getSettings();
const footerFunders = (await getFunders()).filter((f) => f.showInFooter);
const nav = [
  { href: href(lang, '/exhibitions'), label: t(lang, 'exhibitions') },
  { href: href(lang, '/events'), label: t(lang, 'events') },
  { href: href(lang, '/artists'), label: t(lang, 'artists') },
  { href: href(lang, '/about'), label: t(lang, 'about') },
];
const path = Astro.url.pathname;

// Adobe-Fonts-Projekt mit „Minion Pro Italic“ (Projekt-ID aus fonts.adobe.com, z. B. „abc1def“).
// Leer = Ersatzschrift Crimson Pro.
const ADOBE_FONTS_KIT = '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {ADOBE_FONTS_KIT && <link rel="stylesheet" href={`https://use.typekit.net/${ADOBE_FONTS_KIT}.css`} />}
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(path, l), Astro.site)} />)}
    <title>{title ? `${title} – DELPHI_space` : 'DELPHI_space'}</title>
  </head>
  <body>
    <!-- Logo liegt außerhalb der Kopfzeile, damit sein Difference-Effekt mit der ganzen Seite mischt -->
    <a href={href(lang)} class="logo">
      <img src="/delphi-logo.svg" alt="DELPHI_space" width="184" height="38" />
    </a>
    <header class="site-header">
      <span class="logo-spacer" aria-hidden="true"></span>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <span class="lang-switch">
          {locales.map((l) => (
            <a href={switchLang(path, l)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{languageNames[l]}</a>
          ))}
        </span>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <div class="closing-logo">
      <img src="/delphi-tholos.jpg" alt="DELPHI_space" width="215" height="300" loading="lazy" />
    </div>

    {footerFunders.length > 0 && (
      <section class="funders-band">
        <p>{t(lang, 'funders')}</p>
        <div class="logos">
          {footerFunders.map((f) => (
            <a href={f.link || undefined} title={f.name}>
              {f.logo ? <img src={f.logo} alt={f.name} loading="lazy" /> : f.name}
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div>
        <h4>DELPHI_space</h4>
        {settings.address && <p class="address">{settings.address}</p>}
        {settings.email && <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
      </div>
      <div class="footer-links">
        <h4>{t(lang, 'visit')}</h4>
        <a href={href(lang, '/exhibitions')}>{t(lang, 'exhibitions')}</a>
        <a href={href(lang, '/events')}>{t(lang, 'events')}</a>
        <a href={href(lang, '/series')}>{t(lang, 'series')}</a>
        <a href={href(lang, '/membership')}>{t(lang, 'membership')}</a>
        <a href={href(lang, '/press')}>{t(lang, 'press')}</a>
      </div>
      <div class="footer-links">
        <h4>{t(lang, 'follow')}</h4>
        {settings.instagram && <a href={settings.instagram}>Instagram</a>}
        {settings.newsletter && <a href={settings.newsletter}>Newsletter</a>}
        <a href={href(lang, '/impressum')}>{t(lang, 'imprint')}</a>
        <a href={href(lang, '/datenschutz')}>{t(lang, 'privacy')}</a>
      </div>
    </footer>
  </body>
</html>
