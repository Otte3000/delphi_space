---
import '../styles/global.css';
import { getSettings } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'DELPHI_space – Kunst-, Kultur- und Informationszentrum in Freiburg.' } = Astro.props;
const settings = await getSettings();
const nav = [
  { href: '/exhibitions', label: 'Exhibitions' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} – DELPHI_space` : 'DELPHI_space'}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">DELPHI_space</a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        {settings.address && <p class="address">{settings.address}</p>}
        {settings.email && <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
      </div>
      <div class="footer-links">
        {settings.instagram && <a href={settings.instagram}>Instagram</a>}
        {settings.newsletter && <a href={settings.newsletter}>Newsletter</a>}
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
      {settings.sponsors.length > 0 && (
        <div class="sponsors">
          {settings.sponsors.map((s) => (
            <a href={s.url ?? undefined} title={s.name}>
              {s.logo ? <img src={s.logo} alt={s.name} loading="lazy" /> : s.name}
            </a>
          ))}
        </div>
      )}
    </footer>
  </body>
</html>
